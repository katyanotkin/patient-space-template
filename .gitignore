# ALLOWLIST: ignore everything, re-include only what this template publishes.
# Patient data (root working files, records/, visits/, notes, scans) stays
# untracked by default. Keep in sync with .githooks/allowed-paths.sh, which
# is enforced at commit and push time.
*

!.gitignore
!README.md
!SETUP.md
!CLAUDE.md
!init.sh
!PATIENT-GUIDE.md
!LICENSE

!.githooks/
!.githooks/pre-commit
!.githooks/pre-push
!.githooks/allowed-paths.sh

!templates/
!templates/*.md

!.claude/
!.claude/agents/
!.claude/agents/*.md
!.claude/commands/
!.claude/commands/*.md
!.claude/roles/
!.claude/roles/*.md
!.claude/roles/library/
!.claude/roles/library/*.md

!records/
!records/README.md
!visits/
!visits/README.md
!tests/
!tests/README.md
!tests/run-tests.sh

!tools/
!tools/reminders/
!tools/reminders/README.md

# Auto-generated by the roles plugin (must come after the allow rules above)
.claude/roles/registry.md
