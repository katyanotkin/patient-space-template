#!/usr/bin/env bash
# Second layer: block any push whose unpushed commits contain private paths
# (catches commits made with --no-verify or before hooks were enabled).
. "$(dirname "$0")/allowed-paths.sh"
zero=0000000000000000000000000000000000000000
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] && continue   # branch deletion
  bad=$(git rev-list "$lsha" --not --remotes | while read -r c; do
          git diff-tree --root --no-commit-id --name-only --diff-filter=ACMR -r "$c"
        done | sort -u | filter_disallowed)
  if [ -n "$bad" ]; then
    echo "pre-push: refusing to push; commits contain files not on the allowlist (possible private data):" >&2
    echo "$bad" | sed 's/^/  /' >&2
    echo "Remove from history (e.g. git rebase -i / git filter-repo) before pushing." >&2
    exit 1
  fi
done
